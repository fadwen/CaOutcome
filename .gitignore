# Pester / coverage output
coverage.xml
testResults.xml
*.trx

# Run output. Outcomes and baselines name real users, groups, applications and policy ids
# from whatever tenant the module was last run against. Commit a baseline deliberately, from
# the repository that holds the tenant's tests, never from this one.
*.baseline.json
ca-outcome*.json

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Publish staging tree. Build/Publish-Module.ps1 wipes and rebuilds this on every run;
# it holds only copies of files that are tracked elsewhere.
out/

# PlatyPS build intermediate. The Markdown under docs/ is the source and the packaged help
# is en-US/CaOutcome-Help.xml; maml/ is just the staging folder Export-MamlCommandHelp
# writes to on the way there.
maml/

# Update-MarkdownCommandHelp writes these next to the originals.
*.md.bak
